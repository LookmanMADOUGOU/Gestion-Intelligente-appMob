# SMART TECH Mobile - Configuration d'Environnement
# Copiez ce fichier sous le nom .env si vous utilisez flutter_dotenv

# URL de l'API Django
# Émulateur Android officiel : http://10.0.2.2:8000/api
# Simulateur iOS / Bureau : http://127.0.0.1:8000/api
# Émulateur Genymotion : http://10.0.3.2:8000/api
# Smartphone physique (Wi-Fi) : http://192.168.1.X:8000/api
SMART_TECH_API_BASE_URL=http://10.0.2.2:8000/api

# Délais de connexion réseau (millisecondes)
CONNECT_TIMEOUT=15000
RECEIVE_TIMEOUT=15000

# Clé de chiffrement du cache local (AES-256)
SECURE_STORAGE_KEY_ALIAS=smart_tech_secure_keystore
